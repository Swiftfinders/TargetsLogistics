{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "prisma/**", "public/**", "*.config.*", "package.json", "tsconfig.json"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["DATABASE_URL", "API_URL", "NEXT_PUBLIC_API_URL", "NEXT_PUBLIC_SITE_URL", "APP_VERSION"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL", "CORS_ORIGINS", "API_URL", "NEXT_PUBLIC_API_URL", "NEXT_PUBLIC_SITE_URL", "PORT", "APP_VERSION"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "*.config.*", "package.json", "tsconfig.json"],
      "outputs": []
    },
    "lint": {
      "inputs": ["src/**", "*.config.*", "package.json"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "*.config.*"],
      "outputs": [],
      "env": ["DATABASE_URL", "CORS_ORIGINS", "APP_VERSION"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": ["playwright-report/**"],
      "env": ["NEXT_PUBLIC_API_URL", "PLAYWRIGHT_BASE_URL"]
    },
    "lhci": {
      "dependsOn": ["build"],
      "outputs": [".lighthouseci/**"],
      "env": ["NEXT_PUBLIC_API_URL", "NEXT_PUBLIC_SITE_URL", "PORT"]
    }
  }
}
