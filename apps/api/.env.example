# Runtime environment: development | test | production
NODE_ENV=development

# Port the Fastify server listens on
PORT=4000

# PostgreSQL connection string (Railway provides this in production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/targets_dev

# Comma-separated list of allowed CORS origins (the web app's origin(s))
CORS_ORIGINS=http://localhost:3000

# Surfaced in /health for deploy verification; set by CI to the git SHA in production
APP_VERSION=0.0.0

# Resend API key (resend.com) — powers the contact form's email notification,
# password reset, and client-invite emails. Optional: without it, the API
# still boots and everything else still works, it just logs a warning and
# skips sending (see lib/email.ts).
RESEND_API_KEY=

# Domain to scope auth cookies to in production, e.g. ".yourdomain.com" (note
# the leading dot). Leave unset in development — host-only cookies are exactly
# right for localhost. Must be set before staff/client login works across the
# www/api subdomain split in production; see CLAUDE.md and docs/DEPLOYMENT.md.
COOKIE_DOMAIN=

# Base URL of apps/web, used to build links in emails (password reset, client
# invites).
WEB_URL=http://localhost:3000
