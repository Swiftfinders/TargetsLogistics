generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  STAFF
  CLIENT
}

// PENDING: self-signed-up, awaiting staff approval — no usable password yet.
// INVITED: approved (or staff-created directly), set-password email sent.
// ACTIVE: password set, can log in.
enum UserStatus {
  PENDING
  INVITED
  ACTIVE
  SUSPENDED
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum RequestStatus {
  NEW
  ACKNOWLEDGED
  CLOSED
}

enum PackageType {
  ENVELOPE
  BOX
  PALLET
  OTHER
}

enum VehicleType {
  CAR
  MINI_VAN
  CARGO_VAN
  OTHER
}

enum ServiceLevel {
  SAME_DAY
  NEXT_DAY
  FOUR_HOURS
  HOT_RUSH
  CRITICAL
}

// A client company. Created either by a public signup request once staff
// approves it, or directly by staff — see User.status for the signup flow.
model Account {
  id        String        @id @default(uuid())
  name      String
  status    AccountStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  users  User[]
  orders Order[]

  @@map("account")
}

// One table for both staff and client logins, distinguished by userType.
// Every auth check tests userType explicitly rather than inferring role from
// accountId being null — see CLAUDE.md.
model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  passwordHash        String     @map("password_hash")
  name                String
  phone               String?
  userType            UserType   @map("user_type")
  status              UserStatus @default(ACTIVE)
  accountId           String?    @map("account_id")
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt         DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  account             Account?             @relation(fields: [accountId], references: [id])
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  ordersCreated       Order[]              @relation("OrderCreatedBy")
  auditLogs           AuditLog[]

  @@index([accountId])
  @@map("user")
}

// Opaque bearer tokens, not JWTs — only the SHA-256 hash is stored, so a DB
// leak alone doesn't hand out valid sessions. userType is duplicated onto the
// session (not just looked up via user) so a staff-cookie check never has to
// trust anything beyond the session row it just validated.
model Session {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  userType  UserType  @map("user_type")
  ip        String?
  userAgent String?   @map("user_agent")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

// Single-use tokens for both "forgot password" and "staff invited you, set
// your password" — same mechanism, same expiry.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_token")
}

// A delivery order submitted through the public site (no account) or by a
// logged-in client (accountId set). Priced from the Target Logistic rate card
// via packages/shared; estimatedPriceCents is the stored estimate at submit.
model Order {
  id        String @id @default(uuid())
  reference String @unique

  // Null for public (not-logged-in) submissions; set for client submissions.
  accountId       String? @map("account_id")
  createdByUserId String? @map("created_by_user_id")

  pickupContactName String? @map("pickup_contact_name")
  pickupCompany     String? @map("pickup_company")
  pickupPhone       String? @map("pickup_phone")
  pickupAddress     String  @map("pickup_address")

  deliveryContactName String? @map("delivery_contact_name")
  deliveryCompany     String? @map("delivery_company")
  deliveryPhone       String? @map("delivery_phone")
  deliveryAddress     String  @map("delivery_address")

  packageType PackageType? @map("package_type")
  pieces      Int?
  weightKg    Float?       @map("weight_kg")
  dimensions  String?
  contents    String?
  vehicleType VehicleType? @map("vehicle_type")

  serviceLevel        ServiceLevel @map("service_level")
  pickupDate          String?      @map("pickup_date")
  pickupTime          String?      @map("pickup_time")
  specialInstructions String?      @map("special_instructions")

  estimatedPriceCents Int           @map("estimated_price_cents")
  status              RequestStatus @default(NEW)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  account   Account? @relation(fields: [accountId], references: [id])
  createdBy User?    @relation("OrderCreatedBy", fields: [createdByUserId], references: [id])

  @@index([accountId, createdAt])
  @@index([status])
  @@index([createdAt])
  @@map("order")
}

// Staff mutations only (client actions on their own data aren't logged here
// yet — add when there's more than one client-side mutation to distinguish).
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  at         DateTime @default(now()) @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@map("audit_log")
}
