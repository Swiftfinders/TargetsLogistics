# API_URL is server-side only (SSR, rewrites) — points directly at Railway.
API_URL=https://targetslogistics-production.up.railway.app
# NEXT_PUBLIC_API_URL is browser-side — routed through Vercel's rewrite proxy
# so every fetch is same-origin (no CORS, no third-party cookies).
NEXT_PUBLIC_API_URL=/api
# Canonical production URL — drives metadata, canonical tags, sitemap and OG.
NEXT_PUBLIC_SITE_URL=https://www.target-logistics.ca
