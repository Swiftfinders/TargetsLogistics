# Base URL the web app uses for server-side calls to the API
API_URL=http://localhost:4000

# Same API, but exposed to the browser for client-side calls (e.g. the contact
# form). Must be set as a build-time env var on Vercel — Next.js inlines
# NEXT_PUBLIC_* vars at build time, not read at runtime.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: overrides the canonical site URL used in metadata/sitemap/robots.
# Falls back to VERCEL_URL in preview/production, then localhost in dev.
NEXT_PUBLIC_SITE_URL=
